---
const { entry } = Astro.locals.starlightRoute;
const section = entry.id.split('/')[0].replaceAll('-', ' ');
const home = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<div class="os-page-heading">
  <nav class="os-breadcrumb" aria-label="Breadcrumb"><a href={home}>Docs</a><span aria-hidden="true">/</span><span>{section}</span></nav>
  <h1 id="_top" data-page-title>{entry.data.title}</h1>
  {entry.data.description && <p class="os-page-description">{entry.data.description}</p>}
</div>
